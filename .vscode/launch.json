{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Marimo (Dev)",
            "type": "python",
            "request": "launch",
            "module": "marimo",
            "args": [
                "edit",
                "main.py",
                "--watch",
                "--port",
                "8888",
                "--host",
                "localhost"
            ],
            "preLaunchTask": "uv: sync dependencies",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "MARIMO_OUTPUT_MAX_BYTES": "10000000"
            }
        },
        {
            "name": "Debug Marimo (Current File)",
            "type": "debugpy",
            "request": "launch",
            "name": "marimo Debug: edit mode",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}